# ---------------------------------------------------------------------------
# All VITE_* values are compiled into the public JavaScript bundle.
# Only put PUBLIC values here (URLs, public form IDs, contact details).
# Never put API keys, passwords or SMTP credentials in these variables —
# keep those on the server or in your form provider's dashboard.
# ---------------------------------------------------------------------------

# Production domain, e.g. https://www.example.com
# Enables canonical URLs, absolute Open Graph tags and sitemap.xml generation.
VITE_SITE_URL=

# Project enquiries: an endpoint that accepts a JSON POST (Formspree, Basin, your own API…).
VITE_CONTACT_ENDPOINT=

# Job applications: an endpoint that accepts multipart/form-data (supports CV upload).
VITE_CAREERS_ENDPOINT=
# Fallback address for applications when no endpoint is set (opens the applicant's email app).
VITE_CAREERS_EMAIL=

# Optional verified contact details. Leave empty to hide them on the site.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_LOCATION=

# Optional verified social profiles (full URLs). Empty values are hidden.
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_X=
VITE_SOCIAL_GITHUB=
